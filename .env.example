# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
# W GitHub Actions te same nazwy ustawia się jako sekrety repozytorium (patrz README).
BASE_URL=https://kislist.com

# Id listy testowej z adresu https://kislist.com/lists/<id>/edit
KIS_LIST_ID=
# (opcjonalnie) id produktu, pod którym testy dodają komentarze – atrybut id="item-<id>"; domyślnie pierwszy produkt
# KIS_ITEM_ID=

# Członkowie zespołu – jedna skrzynka Gmail z adresami "+", np. login@gmail.com, login+anna@gmail.com …
PIOTR_EMAIL=
PIOTR_PASSWORD=
ANNA_EMAIL=
ANNA_PASSWORD=
MARCIN_EMAIL=
MARCIN_PASSWORD=
MICHALINA_EMAIL=
MICHALINA_PASSWORD=

# Nazwy kont widoczne w aplikacji (autor w powiadomieniu, wybór osoby po "@"); domyślnie imię z zadania
PIOTR_DISPLAY_NAME=Damian Keller
# ANNA_DISPLAY_NAME=
# MARCIN_DISPLAY_NAME=
# MICHALINA_DISPLAY_NAME=

# Skrzynka do odczytu kodów 2FA (wystarczy jedna z dwóch):
# Gmail API, tylko odczyt – klient OAuth typu "Desktop app"; token: npm run gmail:token (patrz README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# albo Mailosaur (https://mailosaur.com) – konta na adresach <nazwa>@<serverId>.mailosaur.net
# MAILOSAUR_API_KEY=
# MAILOSAUR_SERVER_ID=

# Linki dla klienta: udostępniona lista (podgląd na żywo) i propozycja
CLIENT_SHARE_URL=
CLIENT_PROPOSAL_URL=

# Opcjonalnie
# PIOTR_2FA_CODE=1234             # kod 2FA podany ręcznie, gdy skrzynka nie jest skonfigurowana (albo .auth/piotr.code)
# NOTIFICATION_WINDOW_MS=20000   # jak długo czekamy na powiadomienie / na jego brak
# FAKER_SEED=12345               # stały seed = powtarzalne dane testowe
