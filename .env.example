# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
# Wartości bez cudzysłowów i bez komentarzy w tej samej linii – ten sam plik czyta `docker run --env-file .env`.
# W GitHub Actions te same nazwy ustawia się jako sekrety repozytorium (patrz README).
BASE_URL=https://kislist.com

# Id listy testowej z adresu https://kislist.com/lists/<id>/edit
KIS_LIST_ID=
# (opcjonalnie) id produktu, pod którym testy dodają komentarze – atrybut id="item-<id>"; domyślnie pierwszy produkt
# (uwaga: pierwszy element z id="item-…" bywa notatką sekcji – framework bierze pierwszy wiersz z ikoną komentarzy)
# KIS_ITEM_ID=

# Konta powiązane z listą (role z okna „Zaproś do współpracy”) – adresy „+” jednej skrzynki Gmail,
# np. login+piotr@gmail.com; administrator może mieć inny (np. prywatny) adres – patrz ADMIN_DEVICE_ID
# Administrator – założyciel, właściciel konta
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Współpracownik
PIOTR_EMAIL=
PIOTR_PASSWORD=
# Członek zespołu
MARCIN_EMAIL=
MARCIN_PASSWORD=
# Gość – lista tylko do wglądu (kontrola negatywna)
GUEST_EMAIL=
GUEST_PASSWORD=

# Zaufane urządzenie: wartość cookie "devid" (ważne rok) – logowanie bez kodu 2FA.
# Potrzebne dla konta, którego skrzynki testy nie czytają; setup zapisuje ją do .auth/<konto>.device
# ADMIN_DEVICE_ID=

# Skrzynka Gmail z kodami 2FA (adresy „+”) – Gmail API, tylko odczyt – klient OAuth typu "Desktop app"; token: npm run gmail:token (patrz README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Linki dla klienta z e-maili KIS List: udostępniona lista (/list-preview/…) i propozycja (/proposal/preview/…?rk=…)
CLIENT_SHARE_URL=
CLIENT_PROPOSAL_URL=

# Opcjonalnie
# kod 2FA podany ręcznie, gdy skrzynka nie jest czytana (albo .auth/admin.code)
# ADMIN_2FA_CODE=1234
# jak długo czekamy na powiadomienie / na jego brak (ms) – wydłuż, żeby wykluczyć duże opóźnienie, np. 300000
# NOTIFICATION_WINDOW_MS=20000
# stały seed = powtarzalne dane testowe
# FAKER_SEED=12345
