# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
# W GitHub Actions te same nazwy ustawia się jako sekrety repozytorium (patrz README).
BASE_URL=https://www.kislist.com

# Nazwa listy/projektu testowego wgranego na konto
KIS_LIST_NAME=

# Członkowie zespołu (konta z adresami "+", np. twoj.mail+anna@gmail.com)
PIOTR_EMAIL=
PIOTR_PASSWORD=
ANNA_EMAIL=
ANNA_PASSWORD=
MARCIN_EMAIL=
MARCIN_PASSWORD=
MICHALINA_EMAIL=
MICHALINA_PASSWORD=

# Linki dla klienta: udostępniona lista (podgląd na żywo) i propozycja
CLIENT_SHARE_URL=
CLIENT_PROPOSAL_URL=

# Opcjonalnie
# NOTIFICATION_WINDOW_MS=20000   # jak długo czekamy na powiadomienie / na jego brak
# FAKER_SEED=12345               # stały seed = powtarzalne dane testowe
