{
  "name": "rekrutacja-kis",
  "version": "1.0.0",
  "description": "Testy E2E (Playwright + TypeScript) systemu powiadomień o komentarzach w KIS List",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:positive": "playwright test --grep @positive",
    "test:negative": "playwright test --grep @negative",
    "test:regression": "playwright test --grep @regression",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results && allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkelle1/rekrutacja-kis.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/dkelle1/rekrutacja-kis/issues"
  },
  "homepage": "https://github.com/dkelle1/rekrutacja-kis#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "mailosaur": "^11.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
